generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int               @id @default(autoincrement())
  fullName         String
  email            String            @unique
  password         String
  isVerified       Boolean           @default(false)
  otp              String?
  otpExpiry        DateTime?
  resetToken       String?
  resetTokenExpiry DateTime?
  interviewResults InterviewResult[]
}

model InterviewResult {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  category  String // 'dsa', 'python', 'java', 'ai-ml', 'web-development', 'system-design'
  type      String // 'interview' or 'coding-test'
  score     Int // 0-100
  createdAt DateTime @default(now())
}
